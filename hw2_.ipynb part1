    {
      "cell_type": "code",
      "source": [
        "def get_ai_summary(grades):\n",
        "    \"\"\"\n",
        "    呼叫 Gemini 模型來生成成績摘要與常見迷思，並包含重試機制。\n",
        "    \"\"\"\n",
        "    # 準備給 AI 的提示\n",
        "    prompt_text = \"以下是學生的成績列表，請幫我根據這些成績，產出一個簡單的摘要與常見迷思整理（不評分，只做總結）。\\n\\n\"\n",
        "    for record in grades:\n",
        "        date, subject, grade = record\n",
        "        prompt_text += f\"日期：{date}, 科目：{subject}, 成績：{grade}\\n\"\n",
        "\n",
        "    print(\"\\n--- 正在呼叫 AI 模型生成摘要... ---\")\n",
        "\n",
        "    max_retries = 3\n",
        "    retries = 0\n",
        "    # time 已經在程式碼最上方被引入 (cell Niq4EB1Ui-Pk)\n",
        "\n",
        "    while retries < max_retries:\n",
        "        try:\n",
        "            response = client.models.generate_content(model = MODEL_ID, contents = prompt_text)\n",
        "            summary = response.text\n",
        "            return summary\n",
        "        except Exception as e:\n",
        "            error_message = str(e)\n",
        "            print(f\"呼叫 AI 時發生錯誤：{error_message}\")\n",
        "\n",
        "            # 檢查是否為可恢復的錯誤 (503 或 429) 且還有重試次數\n",
        "            if (\"503 UNAVAILABLE\" in error_message or \"429 RESOURCE_EXHAUSTED\" in error_message) and retries < max_retries - 1:\n",
        "                retries += 1\n",
        "                wait_time = 5 * (2 ** (retries - 1)) # 指數退避: 5s, 10s, 20s\n",
        "                error_type = '503' if '503' in error_message else '429'\n",
        "                print(f\"偵測到暫時性錯誤 ({error_type})，將在 {wait_time} 秒後重試 (第 {retries}/{max_retries} 次)。\")\n",
        "                time.sleep(wait_time)\n",
        "            else:\n",
        "                return \"AI 摘要生成失敗。\"\n",
        "    return \"AI 摘要生成失敗。\" # 如果所有重試都失敗，則會執行到這裡"
      ],
      "metadata": {
